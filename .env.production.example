# ============================================================================
# EuroPrint ERP — Production environment template
# ============================================================================
# Copy to /etc/europrint.env (or .env at project root) before deploy.
#
#   sudo cp .env.production.example /etc/europrint.env
#   sudo chmod 600 /etc/europrint.env
#   sudo chown europrint:europrint /etc/europrint.env
#   sudo vim /etc/europrint.env
#
# Then `pm2 start ecosystem.config.cjs --env production` (or
# `docker compose up -d --build`).
#
# ⚠ Every variable below marked REQUIRED must be replaced before first start.
# ============================================================================

# ── REQUIRED: Database ──────────────────────────────────────────────────────
# Connection string with SSL enforced (use full hostname, not localhost).
# Generate password: `openssl rand -base64 32 | tr -d '+/='`
DATABASE_URL=postgresql://europrint:CHANGE_ME@db.internal.europrint.uz:5432/europrint?sslmode=require
PGSSLMODE=require

# ── REQUIRED: JWT secrets ───────────────────────────────────────────────────
# MUST be ≥32 random chars each, MUST differ from each other.
# Generate: `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_ABOVE
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── REQUIRED: Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis.internal.europrint.uz
REDIS_PORT=6379
# REDIS_PASSWORD=CHANGE_ME   # uncomment if Redis is secured

# ── REQUIRED: App ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://erp.europrint.uz
# Comma-separated list of allowed CORS origins:
ALLOWED_ORIGINS=https://erp.europrint.uz,https://m.europrint.uz

# ── REQUIRED ONE-TIME: Initial admin password (for seed command) ────────────
# Run once: `ADMIN_SEED_PASSWORD=... pnpm --filter @europrint/api run seed`
# Then unset / remove from this file.
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── OPTIONAL: Database pool tuning ──────────────────────────────────────────
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# ── OPTIONAL: Rate limiting ─────────────────────────────────────────────────
LOGIN_RATE_LIMIT=5
LOGIN_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_AUTH_LIMIT=5
THROTTLE_AI_LIMIT=20
THROTTLE_REPORT_LIMIT=10
THROTTLE_EXPORT_LIMIT=5

# ── OPTIONAL: Backup cron ───────────────────────────────────────────────────
BACKUP_DIR=/var/backups/europrint
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=/usr/bin/pg_dump

# ── OPTIONAL: Telegram bots ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TG_SALES_GROUP_CHAT_ID=
TG_DIRECTOR_CHAT_ID=
TG_TECHNOLOGIST_CHAT_ID=
TG_FINANCE_CHAT_ID=
TG_PRODUCTION_CHAT_ID=
TG_WAREHOUSE_CHAT_ID=
TG_QC_CHAT_ID=
TG_HR_CHAT_ID=
TG_MRO_CHAT_ID=

# ── OPTIONAL: Financial reports Telegram channels ───────────────────────────
TELEGRAM_KUNLIK_CHAT_ID=
TELEGRAM_HAFTALIK_CHAT_ID=
TELEGRAM_OYLIK_CHAT_ID=
TELEGRAM_MUAMMO_CHAT_ID=
TELEGRAM_VAZIFA_CHAT_ID=
TELEGRAM_QOLLANMA_CHAT_ID=

# ── OPTIONAL: Financial thresholds ──────────────────────────────────────────
FINANCIAL_REPORTS_OVERSTOCK_THRESHOLD=120
FINANCIAL_REPORTS_OVERDUE_DAYS=30

# ── OPTIONAL: AI provider keys (graceful degradation if absent) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── OPTIONAL: Object storage (GCS/AWS S3-compatible) ────────────────────────
GCS_BUCKET=
GCS_KEYFILE=/etc/europrint/gcs-key.json

# ── OPTIONAL: Video calls (Jitsi as a Service / 8x8.vc) ─────────────────────
JITSI_URL=https://8x8.vc
JITSI_APP_ID=
JITSI_KEY_ID=
JITSI_PRIVATE_KEY=

# ── OPTIONAL: Migration switch (set to true after 1-week soak) ──────────────
FK_USE_INT_COLUMNS=true

# ── DEV ONLY (leave empty in production) ────────────────────────────────────
# Swagger UI is disabled in production by the NODE_ENV check; this var is ignored.
SWAGGER_SECRET=

# ── OPTIONAL: Error monitoring (Sentry — graceful degradation if empty) ────
# DSN from sentry.io > Settings > Projects > [project] > Client Keys.
# Leave SENTRY_DSN empty to fully disable Sentry (app still boots, warn-logged).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=2.0.0
# Frontend source-map upload token (vite.config.ts).
# sentry.io > Settings > Account > API > Auth Tokens (scope: project:releases).
SENTRY_AUTH_TOKEN=
# Org/project slugs for @sentry/vite-plugin (defaults: europrint / erp-dashboard).
SENTRY_ORG=europrint
SENTRY_PROJECT=erp-dashboard

# ── OPTIONAL: Slave / read-replica DB (for read-heavy queries) ──────────────
# SLAVE_DATABASE_URL=postgresql://europrint_ro:pass@db-replica.internal:5432/europrint?sslmode=require
