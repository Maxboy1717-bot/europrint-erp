# EuroPrint ERP — Docker build context exclusions
# Without this, every build sends ~2 GB of node_modules + .git to the daemon.

# Dependencies (will be reinstalled by Dockerfile)
**/node_modules
**/.pnpm-store

# Build outputs (will be regenerated by build stage)
**/dist
**/build
**/.next
**/coverage

# Version control + IDE
.git
.gitignore
.gitattributes
.vscode
.idea
*.swp
*.swo

# Claude Code worktrees (very large — ~860 MB)
.claude
.claude.local
**/CLAUDE.md

# Local env files (secrets — image gets env via docker compose)
.env
.env.local
.env.*.local
*.env.local

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.cache

# OS / shell
.DS_Store
Thumbs.db
desktop.ini

# Test artifacts
test-results
playwright-report
playwright/.cache
junit.xml

# Docker / deployment
docker-compose.override.yml
.docker

# Documentation (not needed at runtime)
docs/
*.md
!apps/api/README.md
!artifacts/erp-dashboard/README.md

# Backup data and SQL dumps
backups/
*.sql.gz
*.dump

# Temporary build scripts and audit reports
audit-hardcoded-report.json
cat-no-route.txt
cat-routed-in-sidebar.txt
cat-stub.txt
fix-*.cjs
fix-*.mjs

# Husky (not needed in production image)
.husky

# Misc dev tools
scripts/rule9-violations*.json
scripts/i18n-audit-report.json
