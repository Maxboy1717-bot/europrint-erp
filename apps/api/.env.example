# ============================================================================
# EuroPrint API .env namuna (template)
# ============================================================================
# Bu faylni nusxalab `.env` qiling va o'z qiymatlaringizni kiriting:
#   cp .env.example .env
# ============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/europrint
PGSSLMODE=disable

# --- JWT (production uchun: openssl rand -hex 32) ---------------------------
JWT_SECRET=change-me-min-32-chars-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-me-min-32-chars-different-from-above
JWT_REFRESH_EXPIRES_IN=7d

# --- Swagger (dev only, bo'sh bo'lsa o'chirilgan) --------------------------
# SWAGGER_SECRET=local-swagger-dev-only

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- App --------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:20806
ALLOWED_ORIGINS=http://localhost:20806,http://localhost:20807,http://localhost:5173

# --- Admin seed (faqat 1-marta) --------------------------------------------
ADMIN_SEED_PASSWORD=ChangeMeStrong123!
ERP_ADMIN_PASSWORD=ChangeMeStrong123!

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TG_SALES_GROUP_CHAT_ID=
TG_DIRECTOR_CHAT_ID=
TG_TECHNOLOGIST_CHAT_ID=
TG_FINANCE_CHAT_ID=
TG_PRODUCTION_CHAT_ID=
TG_WAREHOUSE_CHAT_ID=
TG_QC_CHAT_ID=
TG_HR_CHAT_ID=
TG_MRO_CHAT_ID=

# --- FK migration switch ----------------------------------------------------
FK_USE_INT_COLUMNS=false

# --- AI provider keys (ixtiyoriy) ------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Object Storage (ixtiyoriy) --------------------------------------------
GCS_BUCKET=
GCS_KEYFILE=
