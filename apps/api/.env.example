# ============================================================================
# EuroPrint API .env namuna (template)
# ============================================================================
# Bu faylni nusxalab `.env` qiling va o'z qiymatlaringizni kiriting:
#   cp .env.example .env
# ============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/europrint
PGSSLMODE=disable

# --- JWT (production uchun: openssl rand -hex 32) ---------------------------
JWT_SECRET=change-me-min-32-chars-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-me-min-32-chars-different-from-above
JWT_REFRESH_EXPIRES_IN=7d

# --- Swagger (dev only, bo'sh bo'lsa o'chirilgan) --------------------------
# SWAGGER_SECRET=local-swagger-dev-only

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- App --------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:20806
ALLOWED_ORIGINS=http://localhost:20806,http://localhost:20807,http://localhost:5173

# --- Admin seed (faqat 1-marta) --------------------------------------------
ADMIN_SEED_PASSWORD=ChangeMeStrong123!
ERP_ADMIN_PASSWORD=ChangeMeStrong123!

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TG_SALES_GROUP_CHAT_ID=
TG_DIRECTOR_CHAT_ID=
TG_TECHNOLOGIST_CHAT_ID=
TG_FINANCE_CHAT_ID=
TG_PRODUCTION_CHAT_ID=
TG_WAREHOUSE_CHAT_ID=
TG_QC_CHAT_ID=
TG_HR_CHAT_ID=
TG_MRO_CHAT_ID=

# --- FK migration switch ----------------------------------------------------
FK_USE_INT_COLUMNS=false

# --- AI provider keys (ixtiyoriy) ------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Object Storage (ixtiyoriy) --------------------------------------------
GCS_BUCKET=
GCS_KEYFILE=

# --- Financial Reports Telegram channels ------------------------------------
TELEGRAM_KUNLIK_CHAT_ID=        # Kunlik hisobotlar kanali
TELEGRAM_HAFTALIK_CHAT_ID=      # Haftalik hisobotlar kanali
TELEGRAM_OYLIK_CHAT_ID=         # Oylik hisobotlar kanali
TELEGRAM_MUAMMO_CHAT_ID=        # Muammolar / ogohlantirishlar kanali
TELEGRAM_VAZIFA_CHAT_ID=        # Vazifalar kanali
TELEGRAM_QOLLANMA_CHAT_ID=      # Qo'llanmalar va Org-politika kanali

# --- Financial Reports thresholds ------------------------------------------
FINANCIAL_REPORTS_OVERSTOCK_THRESHOLD=120   # % of 30d avg before overstock alert
FINANCIAL_REPORTS_OVERDUE_DAYS=30           # days before receivable becomes overdue alert

# --- DB connection pool (Infrastructure Audit) ------------------------------
# DATABASE_URL  hardcoded fallback olib tashlandi — endi shart bo'lib qoldi
DB_POOL_MAX=20            # maksimal connection (default 20 — 24 modul uchun yetarli)
DB_POOL_MIN=2             # minimal idle connection
DB_IDLE_TIMEOUT_MS=30000  # bo'sh connection necha ms da yopiladi
DB_CONN_TIMEOUT_MS=5000   # yangi connection timeout

# --- Rate Limiting (env-configurable) --------------------------------------
LOGIN_RATE_LIMIT=5            # /api/auth/login uchun urinishlar / daqiqa
LOGIN_TTL_MS=60000            # derazaning uzunligi (ms)
THROTTLE_DEFAULT_LIMIT=100    # umumiy endpointlar (req/daq)
THROTTLE_AUTH_LIMIT=5         # /auth/* (brute-force)
THROTTLE_AI_LIMIT=20          # LLM chaqiruvi (Claude/OpenAI cost)
THROTTLE_REPORT_LIMIT=10      # /reports/* og'ir hisobotlar
THROTTLE_EXPORT_LIMIT=5       # PDF/Excel eksport
