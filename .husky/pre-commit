# EuroPrint - pre-commit hook (Husky v9)
# Maqsad: noto'g'ri kodlarni main'ga tushirmaslik
# Aqlli: faqat tegishli fayllar o'zgarganda typecheck ishlaydi.

set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# 1) lint-staged har doim ishlaydi (faqat o'zgargan fayllar uchun)
echo ""
echo "==> [1/3] lint-staged"
pnpm exec lint-staged || {
  echo ""
  echo "X  lint-staged xato bilan tugadi. Commit to'xtatildi."
  exit 1
}

# 2) Backend typecheck — faqat apps/api/**/*.ts o'zgarsa
if echo "$STAGED" | grep -qE '^apps/api/.*\.ts$'; then
  echo ""
  echo "==> [2/3] Backend typecheck (apps/api)"
  pnpm --filter @europrint/api exec tsc --noEmit || {
    echo ""
    echo "X  TypeScript xatolari topildi (apps/api). Commit to'xtatildi."
    exit 1
  }
else
  echo ""
  echo "==> [2/3] Backend typecheck o'tkazildi (apps/api o'zgarmagan)"
fi

# 3) Frontend typecheck — faqat erp-dashboard/**/*.{ts,tsx} o'zgarsa
if echo "$STAGED" | grep -qE '^artifacts/erp-dashboard/.*\.(ts|tsx)$'; then
  echo ""
  echo "==> [3/3] Frontend typecheck (artifacts/erp-dashboard)"
  pnpm --filter @workspace/erp-dashboard run typecheck || {
    echo ""
    echo "X  TypeScript xatolari topildi (erp-dashboard). Commit to'xtatildi."
    exit 1
  }
else
  echo ""
  echo "==> [3/3] Frontend typecheck o'tkazildi (erp-dashboard o'zgarmagan)"
fi

echo ""
echo "OK: Pre-commit tekshiruvlar muvaffaqiyatli o'tdi."
