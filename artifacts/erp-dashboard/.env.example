# ============================================================================
# EuroPrint ERP Dashboard — frontend env namuna
# ============================================================================
# Bu faylni nusxalab `.env.local` qiling:
#   cp .env.example .env.local
#
# Faqat VITE_ prefiksli o'zgaruvchilar brauzerga uzatiladi.
# ============================================================================

# Backend API
NEST_API_URL=http://localhost:3000
API_URL=http://localhost:3000
BASE_PATH=/erp-dashboard/

# Jitsi Meet URL (bo'sh bo'lsa public meet.jit.si ishlatiladi)
VITE_JITSI_URL=

# Sentry — frontend
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# ─── Feature flags ────────────────────────────────────────────────────────────
# Marketing moduli (tz02) — backend ~60/99 endpoint 501 qaytaradi. Foydalanuvchi
# mijozlariga ko'rinmasligi uchun standart holda o'chirilgan. Faqat dev/test
# muhitida menyuni ochish uchun `true` qiling.
VITE_FEATURE_MARKETING=false
