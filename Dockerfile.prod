# EuroPrint ERP — Production Multi-Stage Dockerfile
# Builds API + frontend, packages into a minimal Node 20 runtime image.

# ========== Stage 1: Build ==========
FROM node:20-alpine AS builder

RUN apk add --no-cache python3 make g++ git

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# Copy package manifests for layer caching
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY artifacts/erp-dashboard/package.json artifacts/erp-dashboard/
COPY lib/db/package.json lib/db/
COPY lib/api-zod/package.json lib/api-zod/
COPY lib/api-client-react/package.json lib/api-client-react/
COPY lib/math-utils/package.json lib/math-utils/

RUN pnpm install --frozen-lockfile

# Copy source + build
COPY . .
RUN pnpm --filter @workspace/db run build || true
RUN pnpm --filter @europrint/api run build
RUN pnpm --filter @workspace/erp-dashboard run build

# ========== Stage 2: Runtime ==========
FROM node:20-alpine AS runtime

RUN apk add --no-cache tini wget && \
    addgroup -g 1001 nodejs && adduser -D -u 1001 -G nodejs europrint

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# Copy built artifacts only
COPY --from=builder --chown=europrint:nodejs /app/apps/api/dist          ./apps/api/dist
COPY --from=builder --chown=europrint:nodejs /app/apps/api/package.json  ./apps/api/
COPY --from=builder --chown=europrint:nodejs /app/artifacts/erp-dashboard/dist ./artifacts/erp-dashboard/dist
COPY --from=builder --chown=europrint:nodejs /app/node_modules           ./node_modules
COPY --from=builder --chown=europrint:nodejs /app/pnpm-workspace.yaml    ./
COPY --from=builder --chown=europrint:nodejs /app/pnpm-lock.yaml         ./
COPY --from=builder --chown=europrint:nodejs /app/package.json           ./
COPY --from=builder --chown=europrint:nodejs /app/lib                    ./lib

USER europrint

ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget -qO- http://localhost:4000/api/health || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/api/dist/main.js"]
