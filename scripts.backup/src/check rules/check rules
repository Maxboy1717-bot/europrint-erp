#!/usr/bin/env bash

# ============================================================
# KOD QOIDALARI TEKSHIRUVCHI
# ============================================================

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

ROOT="apps/api/src"
ERRORS=0
WARNINGS=0

echo -e "${CYAN}============================================================${NC}"
echo -e "${CYAN}  KOD QOIDALARI TEKSHIRUVI${NC}"
echo -e "${CYAN}============================================================${NC}"
echo ""

# ------------------------------------------------------------
# 1. FAYL HAJMI: 300 qatordan katta fayllar
# ------------------------------------------------------------
echo -e "${CYAN}[1] Fayl hajmi (maks 300 qator)${NC}"
while IFS= read -r -d '' file; do
  lines=$(wc -l < "$file")
  if [ "$lines" -gt 300 ]; then
    echo -e "  ${RED}✗ KATTA:${NC} $file — ${lines} qator"
    ((ERRORS++))
  fi
done < <(find "$ROOT" -name "*.ts" -not -path "*/node_modules/*" -print0)
echo ""

# ------------------------------------------------------------
# 2. any TIPI
# ------------------------------------------------------------
echo -e "${CYAN}[2] 'any' tipi ishlatilishi${NC}"
while IFS= read -r -d '' file; do
  matches=$(grep -nP ':\s*any\b|<any>|as\s+any\b' "$file" 2>/dev/null)
  if [ -n "$matches" ]; then
    echo -e "  ${RED}✗ any:${NC} $file"
    echo "$matches" | while IFS= read -r line; do
      echo -e "      ${YELLOW}→${NC} $line"
    done
    ((ERRORS++))
  fi
done < <(find "$ROOT" -name "*.ts" -not -path "*/node_modules/*" -print0)
echo ""

# ------------------------------------------------------------
# 3. console.log
# ------------------------------------------------------------
echo -e "${CYAN}[3] console.log ishlatilishi${NC}"
while IFS= read -r -d '' file; do
  matches=$(grep -nP 'console\.(log|warn|error|debug|info)\(' "$file" 2>/dev/null)
  if [ -n "$matches" ]; then
    echo -e "  ${RED}✗ console:${NC} $file"
    echo "$matches" | while IFS= read -r line; do
      echo -e "      ${YELLOW}→${NC} $line"
    done
    ((ERRORS++))
  fi
done < <(find "$ROOT" -name "*.ts" -not -path "*/node_modules/*" -print0)
echo ""

# ------------------------------------------------------------
# 4. Controller da if/else va biznes logika
# ------------------------------------------------------------
echo -e "${CYAN}[4] Controller da if/else va biznes logika${NC}"
while IFS= read -r -d '' file; do
  basename=$(basename "$file")
  if [[ "$basename" == *.controller.ts ]]; then
    matches=$(grep -nP '^\s*(if|else|switch|for|while)\s*[\(\{]' "$file" 2>/dev/null)
    if [ -n "$matches" ]; then
      echo -e "  ${RED}✗ LOGIKA:${NC} $file"
      echo "$matches" | while IFS= read -r line; do
        echo -e "      ${YELLOW}→${NC} $line"
      done
      ((ERRORS++))
    fi
  fi
done < <(find "$ROOT" -name "*.controller.ts" -not -path "*/node_modules/*" -print0)
echo ""

# ------------------------------------------------------------
# 5. Service da to'g'ridan-to'g'ri db.* chaqiruvlar
# ------------------------------------------------------------
echo -e "${CYAN}[5] Service da to'g'ridan-to'g'ri db.* chaqiruvlar${NC}"
while IFS= read -r -d '' file; do
  basename=$(basename "$file")
  if [[ "$basename" == *.service.ts ]]; then
    matches=$(grep -nP '\bthis\.db\.(select|insert|update|delete|query)\b' "$file" 2>/dev/null)
    if [ -n "$matches" ]; then
      echo -e "  ${RED}✗ DB_DIRECT:${NC} $file"
      echo "$matches" | while IFS= read -r line; do
        echo -e "      ${YELLOW}→${NC} $line"
      done
      ((ERRORS++))
    fi
  fi
done < <(find "$ROOT" -name "*.service.ts" -not -path "*/node_modules/*" -print0)
echo ""

# ------------------------------------------------------------
# 6. Non-null assertion (!)
# ------------------------------------------------------------
echo -e "${CYAN}[6] Non-null assertion (!) ishlatilishi${NC}"
while IFS= read -r -d '' file; do
  matches=$(grep -nP '[a-zA-Z0-9_\]\)]\!' "$file" 2>/dev/null | grep -v '//' | grep -v "'.*!'.*'" | grep -vP '!=|!==|!\s')
  if [ -n "$matches" ]; then
    echo -e "  ${YELLOW}⚠ NON-NULL:${NC} $file"
    echo "$matches" | while IFS= read -r line; do
      echo -e "      ${YELLOW}→${NC} $line"
    done
    ((WARNINGS++))
  fi
done < <(find "$ROOT" -name "*.ts" -not -path "*/node_modules/*" -print0)
echo ""

# ------------------------------------------------------------
# 7. Raw SQL
# ------------------------------------------------------------
echo -e "${CYAN}[7] Raw SQL (sql\` yoki db.execute)${NC}"
while IFS= read -r -d '' file; do
  basename=$(basename "$file")
  # report fayllarida ruxsat berilgan
  if [[ "$basename" == *report* ]] || [[ "$basename" == *migration* ]] || [[ "$basename" == *seed* ]]; then
    continue
  fi
  matches=$(grep -nP "sql\`|db\.execute\(|db\.query\(" "$file" 2>/dev/null)
  if [ -n "$matches" ]; then
    echo -e "  ${YELLOW}⚠ RAW_SQL:${NC} $file"
    echo "$matches" | while IFS= read -r line; do
      echo -e "      ${YELLOW}→${NC} $line"
    done
    ((WARNINGS++))
  fi
done < <(find "$ROOT" -name "*.ts" -not -path "*/node_modules/*" -print0)
echo ""

# ------------------------------------------------------------
# 8. Magic numbers
# ------------------------------------------------------------
echo -e "${CYAN}[8] Magic numbers (hardcoded raqamlar)${NC}"
while IFS= read -r -d '' file; do
  matches=$(grep -nP '(?<![A-Za-z0-9_])[2-9][0-9]+(?![A-Za-z0-9_])' "$file" 2>/dev/null \
    | grep -v 'const ' \
    | grep -v '//' \
    | grep -v 'migration' \
    | grep -v 'seed' \
    | grep -v '\.spec\.' \
    | head -5)
  if [ -n "$matches" ]; then
    echo -e "  ${YELLOW}⚠ MAGIC:${NC} $file"
    echo "$matches" | while IFS= read -r line; do
      echo -e "      ${YELLOW}→${NC} $line"
    done
    ((WARNINGS++))
  fi
done < <(find "$ROOT" -name "*.ts" -not -path "*/node_modules/*" -not -name "*.spec.ts" -print0)
echo ""

# ------------------------------------------------------------
# 9. try/catch (Result pattern o'rniga)
# ------------------------------------------------------------
echo -e "${CYAN}[9] try/catch (Result pattern ishlatilishi tavsiya etiladi)${NC}"
while IFS= read -r -d '' file; do
  matches=$(grep -nP '^\s*try\s*\{' "$file" 2>/dev/null)
  if [ -n "$matches" ]; then
    count=$(echo "$matches" | wc -l)
    echo -e "  ${YELLOW}⚠ TRY/CATCH ($count ta):${NC} $file"
    ((WARNINGS++))
  fi
done < <(find "$ROOT" -name "*.ts" -not -path "*/node_modules/*" -print0)
echo ""

# ------------------------------------------------------------
# XULOSA
# ------------------------------------------------------------
echo -e "${CYAN}============================================================${NC}"
echo -e "${CYAN}  XULOSA${NC}"
echo -e "${CYAN}============================================================${NC}"

if [ "$ERRORS" -eq 0 ] && [ "$WARNINGS" -eq 0 ]; then
  echo -e "${GREEN}  ✓ Barcha qoidalar bajarilgan!${NC}"
else
  echo -e "${RED}  ✗ XATOLAR:    ${ERRORS} ta${NC}"
  echo -e "${YELLOW}  ⚠ OGOHLANTIRISHLAR: ${WARNINGS} ta${NC}"
fi

echo ""
echo -e "  Ishlatish: ${CYAN}bash <skript_nomi>.sh${NC}"
echo -e "${CYAN}============================================================${NC}"

exit $ERRORS