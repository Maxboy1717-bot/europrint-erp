# ============================================================================
# EuroPrint Workspace — root .env namuna (template)
# ============================================================================
# Bu faylni nusxalab `.env` qiling:
#   cp .env.example .env
#
# TO'LIQ konfiguratsiya: apps/api/.env.example ga qarang.
# DIQQAT: Haqiqiy sirlarni (secret) bu faylga yozmang!
#         Produksiyon uchun: secrets manager yoki CI/CD environment variables.
# ============================================================================

# JWT kaliti — kamida 64 hex belgili random string.
# Yaratish uchun (Linux/macOS yoki Git Bash):
#   openssl rand -hex 32
# Windows PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
JWT_SECRET=<change-me-generate-with-openssl-rand-hex-32>

# JWT refresh token kaliti — JWT_SECRET'dan FARQLI bo'lishi shart.
JWT_REFRESH_SECRET=<change-me-generate-a-DIFFERENT-openssl-rand-hex-32>
