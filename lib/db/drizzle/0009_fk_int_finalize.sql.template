-- ARCHITECTURE.md FK migration finalize — Bo'lim D, 2-bosqich
--
-- ⚠️ DIQQAT: Bu fayl `.template` — to'g'ridan ishga tushirmang!
-- Avval 1 hafta soak (production'da `FK_USE_INT_COLUMNS=true` bilan barcha
-- query'lar yangi ustunlardan ishlasin), keyin .sql ga qayta nomlab ishga tushiring.
--
-- Strategiya:
--   1. Eski varchar ustunni DROP
--   2. _int ustunni eski nomga RENAME
--   3. FK constraint qo'shish
--   4. Sync trigger'ni o'chirish
--
-- ROLLBACK rejasi:
--   Agar bu migration sinishi yo'q bo'lsa — Replit Checkpoint dan oldingi DB ga qaytish.

BEGIN;

-- ─── customer_orders.customer_id ─────────────────────────────────────────────
ALTER TABLE customer_orders DROP COLUMN IF EXISTS customer_id;
ALTER TABLE customer_orders RENAME COLUMN customer_id_int TO customer_id;
ALTER TABLE customer_orders
  ADD CONSTRAINT fk_customer_orders_customer
  FOREIGN KEY (customer_id) REFERENCES customer_accounts(id) ON DELETE SET NULL;

-- ─── public_products.category_id ─────────────────────────────────────────────
ALTER TABLE public_products DROP COLUMN IF EXISTS category_id;
ALTER TABLE public_products RENAME COLUMN category_id_int TO category_id;
ALTER TABLE public_products
  ADD CONSTRAINT fk_public_products_category
  FOREIGN KEY (category_id) REFERENCES product_categories(id) ON DELETE SET NULL;

-- ─── public_products.erp_product_id ──────────────────────────────────────────
ALTER TABLE public_products DROP COLUMN IF EXISTS erp_product_id;
ALTER TABLE public_products RENAME COLUMN erp_product_id_int TO erp_product_id;
ALTER TABLE public_products
  ADD CONSTRAINT fk_public_products_erp_product
  FOREIGN KEY (erp_product_id) REFERENCES products(id) ON DELETE SET NULL;

-- ─── sd_leads.manager_id ─────────────────────────────────────────────────────
ALTER TABLE sd_leads DROP COLUMN IF EXISTS manager_id;
ALTER TABLE sd_leads RENAME COLUMN manager_id_int TO manager_id;
ALTER TABLE sd_leads
  ADD CONSTRAINT fk_sd_leads_manager
  FOREIGN KEY (manager_id) REFERENCES employees(id) ON DELETE SET NULL;

-- ─── sd_payments.customer_id ─────────────────────────────────────────────────
ALTER TABLE sd_payments DROP COLUMN IF EXISTS customer_id;
ALTER TABLE sd_payments RENAME COLUMN customer_id_int TO customer_id;

-- ─── sales_invoices.order_id ─────────────────────────────────────────────────
ALTER TABLE sales_invoices DROP COLUMN IF EXISTS order_id;
ALTER TABLE sales_invoices RENAME COLUMN order_id_int TO order_id;

-- ─── sales_invoices.gl_document_id (agar mos bo'lsa) ─────────────────────────
DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'sales_invoices' AND column_name = 'gl_document_id_int') THEN
    ALTER TABLE sales_invoices DROP COLUMN IF EXISTS gl_document_id;
    ALTER TABLE sales_invoices RENAME COLUMN gl_document_id_int TO gl_document_id;
  END IF;
END $$;

-- ─── sales_orders.tech_approved_by / created_by / changed_by ─────────────────
DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'sales_orders' AND column_name = 'tech_approved_by_int') THEN
    ALTER TABLE sales_orders DROP COLUMN IF EXISTS tech_approved_by;
    ALTER TABLE sales_orders RENAME COLUMN tech_approved_by_int TO tech_approved_by;
  END IF;
  IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'sales_orders' AND column_name = 'created_by_int') THEN
    ALTER TABLE sales_orders DROP COLUMN IF EXISTS created_by;
    ALTER TABLE sales_orders RENAME COLUMN created_by_int TO created_by;
  END IF;
  IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'sales_orders' AND column_name = 'changed_by_int') THEN
    ALTER TABLE sales_orders DROP COLUMN IF EXISTS changed_by;
    ALTER TABLE sales_orders RENAME COLUMN changed_by_int TO changed_by;
  END IF;
END $$;

-- ─── crm_deals.assigned_to / crm_leads.assigned_to ───────────────────────────
DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'crm_deals' AND column_name = 'assigned_to_int') THEN
    ALTER TABLE crm_deals DROP COLUMN IF EXISTS assigned_to;
    ALTER TABLE crm_deals RENAME COLUMN assigned_to_int TO assigned_to;
  END IF;
  IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'crm_leads' AND column_name = 'assigned_to_int') THEN
    ALTER TABLE crm_leads DROP COLUMN IF EXISTS assigned_to;
    ALTER TABLE crm_leads RENAME COLUMN assigned_to_int TO assigned_to;
  END IF;
END $$;

-- ─── Sync triggerlarini olib tashlash ────────────────────────────────────────
DROP TRIGGER IF EXISTS tr_customer_orders_sync_int ON customer_orders;
DROP TRIGGER IF EXISTS tr_public_products_sync_int ON public_products;
DROP FUNCTION IF EXISTS _sync_int_fk_trigger();
DROP FUNCTION IF EXISTS _safe_text_to_int(TEXT);

COMMIT;

